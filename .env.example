# PyTorchInsight 环境变量配置
# 复制此文件为 .env 后填入你的凭据：cp .env.example .env

# ============================================================
# GitHub（必需）
# ============================================================
# GitHub Personal Access Token，需要 repo 读取权限
# 获取方式：https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# ============================================================
# Discourse 论坛（可选）
# ============================================================
# PyTorch Discourse 论坛 API 凭据
# 如不配置，论坛相关数据将跳过采集
# 获取方式：https://discuss.pytorch.org 用户设置 → API Keys
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=

# ============================================================
# 额外 PATH（可选）
# ============================================================
# 如需在 cron 中使用 conda/miniforge，填入其 bin 路径
# EXTRA_PATH=$HOME/miniforge3/bin

# ============================================================
# Copilot 模型（可选）
# ============================================================
# 分开配置日报/周报模型
# COPILOT_DAILY_MODEL=gpt-5.2
# COPILOT_WEEKLY_MODEL=gpt-5.2
# 兼容兜底：如果未设置上面两个变量，则回退到 COPILOT_MODEL，再回退到 auto
# COPILOT_MODEL=auto

# ============================================================
# 代理（可选）
# ============================================================
# 如在需要代理的网络环境中，取消注释并填入代理地址
# http_proxy=http://your-proxy:port
# https_proxy=http://your-proxy:port
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port

# ============================================================
# 邮件（必需）
# ============================================================
REPORT_TO_EMAIL=you@example.com
REPORT_TO_EMAIL_PROD=team@example.com
REPORT_FROM_EMAIL=pytorch-community-report@example.com
SMTP_MX_SERVERS=smtp.example.com
SMTP_PORT=25
SMTP_TIMEOUT=30
